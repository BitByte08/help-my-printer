#!/bin/sh
# SL-J1660을 찾아 CUPS 큐를 만들거나 장치 주소를 갱신한다. udev → j1660-queue.service에서 실행된다.
# 드라이버 선택 근거는 저장소의 filter-test/README.md 참고.
#   DEVICE_URI  장치 주소를 직접 지정 (테스트용)
set -e
QUEUE=${QUEUE:-J1660}
PPD=${PPD:-drv:///hp/hpcups.drv/hp-deskjet_2130_series.ppd}

i=0
until lpstat -r >/dev/null 2>&1; do
    i=$((i + 1))
    [ "$i" -le 30 ] || { echo "cupsd not responding" >&2; exit 1; }
    sleep 1
done

uri=${DEVICE_URI:-$(lpinfo --include-schemes usb -v | awk '$2 ~ /^usb:\/\/Samsung\/SL-J16/ { print $2; exit }')}
if [ -z "$uri" ]; then
    echo "SL-J1660 not found" >&2
    exit 0
fi

current=$(lpstat -v "$QUEUE" 2>/dev/null | awk '{ print $NF }')
if [ "$current" = "$uri" ]; then
    echo "$QUEUE already configured: $uri"
    exit 0
fi

lpadmin -p "$QUEUE" -E -v "$uri" -m "$PPD" \
    -D "Samsung SL-J1660" -L "$(hostname)" \
    -o printer-is-shared=true -o PageSize=A4 -o OutputMode=Normal

# hpcups 대신 래퍼(hpcups-j1660)를 쓰게 하고 Windows 호환 옵션을 추가한다. 기본은 꺼짐.
ppd=$(mktemp)
sed 's|^\*cupsFilter: "application/vnd.cups-raster 0 hpcups"$|*cupsFilter: "application/vnd.cups-raster 0 hpcups-j1660"|' \
    "/etc/cups/ppd/$QUEUE.ppd" > "$ppd"
grep -q hpcups-j1660 "$ppd" || { echo "PPD has no hpcups filter line" >&2; rm -f "$ppd"; exit 1; }
cat >> "$ppd" <<'EOF'
*OpenUI *J1660Compat/Windows Driver Compatibility: Boolean
*OrderDependency: 100 AnySetup *J1660Compat
*DefaultJ1660Compat: False
*J1660Compat False/Off: ""
*J1660Compat True/On: ""
*CloseUI: *J1660Compat
EOF
lpadmin -p "$QUEUE" -P "$ppd"
rm -f "$ppd"

lpadmin -d "$QUEUE"
echo "$QUEUE configured: $uri"
